          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(rate({container=~\"$container\"} |~ \"(?i)error|exception|fatal|panic\" [$__auto]))",
          "refId": "A",
