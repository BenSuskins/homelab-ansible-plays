    {
      "title": "Nodes Up",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(pve_up{node=~\"$node\",id=\"\"})",
          "refId": "A",
          "legendFormat": "Up"
        },
        {
          "expr": "count(pve_up{node=~\"$node\",id=\"\"})",
          "refId": "B",
          "legendFormat": "Total"
        }
