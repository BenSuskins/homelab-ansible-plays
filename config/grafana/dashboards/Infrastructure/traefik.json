      },
      "targets": [
        {
          "expr": "topk(10, sum by (service) (rate(traefik_service_requests_total{service=~\"$service\",protocol=\"http\"}[$__rate_interval])))",
          "refId": "A",
          "legendFormat": "{{ service }}"
        }
