      },
      "targets": [
        {
          "expr": "sum by (entrypoint) (rate(traefik_entrypoint_requests_total{entrypoint=~\"$entrypoint\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{ entrypoint }}"
        }
      ]
    },
