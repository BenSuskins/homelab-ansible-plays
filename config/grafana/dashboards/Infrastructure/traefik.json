            },
            "tooltip": {
              "mode": "multi"
            }
          },
          "targets": [
            {
              "expr": "sum by (entrypoint) (traefik_open_connections{entrypoint=~\"$entrypoint\"})",
              "refId": "A",
              "legendFormat": "{{ entrypoint }}"
            }
          ]
        }
      ]
